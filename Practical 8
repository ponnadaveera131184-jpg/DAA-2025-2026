
#include <iostream>
#include <vector>
#include <queue>
using namespace std;

void DFS(int node, vector<vector<int>>& graph,
         vector<bool>& visited) {
    visited[node] = true;
    cout << node << " ";

    for (int neighbour : graph[node]) {
        if (!visited[neighbour]) {
            DFS(neighbour, graph, visited);
        }
    }
}

void BFS(int start, vector<vector<int>>& graph, int n) {
    vector<bool> visited(n, false);
    queue<int> q;

    visited[start] = true;
    q.push(start);

    while (!q.empty()) {
        int node = q.front();
        q.pop();

        cout << node << " ";

        for (int neighbour : graph[node]) {
            if (!visited[neighbour]) {
                visited[neighbour] = true;
                q.push(neighbour);
            }
        }
    }
}

int main() {
    int n, edges;

    cout << "Enter number of vertices: ";
    cin >> n;

    if (n <= 0) {
        cout << "Invalid number of vertices!";
        return 0;
    }

    vector<vector<int>> graph(n);

    cout << "Enter number of edges: ";
    cin >> edges;

    if (edges < 0) {
        cout << "Invalid number of edges!";
        return 0;
    }

    cout << "Enter edges (u v): " << endl;

    for (int i = 0; i < edges; i++) {
        int u, v;
        cin >> u >> v;

        if (u < 0 || u >= n || v < 0 || v >= n) {
            cout << "Invalid edge!";
            return 0;
        }

        graph[u].push_back(v);
        graph[v].push_back(u);
    }

    int start;
    cout << "Enter starting vertex: ";
    cin >> start;

    if (start < 0 || start >= n) {
        cout << "Invalid starting vertex!";
        return 0;
    }

    vector<bool> visited(n, false);

    cout << "DFS Traversal: ";
    DFS(start, graph, visited);

    cout << endl;

    cout << "BFS Traversal: ";
    BFS(start, graph, n);

    cout << endl;

    return 0;
}
