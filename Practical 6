
#include <iostream>
#include <vector>
#include <climits>
using namespace std;

int matrixChain(vector<int>& p, int n) {
    vector<vector<long long>> dp(n + 1,
        vector<long long>(n + 1, 0));

    for (int len = 2; len <= n; len++) {
        for (int i = 1; i <= n - len + 1; i++) {
            int j = i + len - 1;
            dp[i][j] = LLONG_MAX;

            for (int k = i; k < j; k++) {
                long long cost = dp[i][k]
                    + dp[k + 1][j]
                    + 1LL * p[i - 1] * p[k] * p[j];

                dp[i][j] = min(dp[i][j], cost);
            }
        }
    }

    return dp[1][n];
}

int main() {
    int n;

    cout << "Enter number of matrices: ";
    cin >> n;

    if (n <= 0) {
        cout << "Invalid number of matrices!";
        return 0;
    }

    vector<int> p(n + 1);

    cout << "Enter dimensions: ";
    for (int i = 0; i <= n; i++) {
        cin >> p[i];
    }

    cout << "Minimum number of multiplications: "
         << matrixChain(p, n) << endl;

    return 0;
}
